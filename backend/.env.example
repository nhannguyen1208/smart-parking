NODE_ENV=development
DEMO_MODE=true
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/parkwise
JWT_SECRET=replace-with-long-random-local-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-local-secret
# Comma-separated. Include Vercel URL when FE is hosted separately.
CORS_ORIGIN=http://localhost:3000
# Required for Vercel FE → public API (cookies over HTTPS cross-site)
CROSS_SITE_COOKIES=false

# MQTT — leave MQTT_ENABLED=false for in-process DEMO simulate scan
MQTT_ENABLED=false
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=parkwise_dev
MQTT_PASSWORD=replace-locally
MQTT_CLIENT_ID=parkwise-api

# External adapters (placeholders — never put secrets in VITE_/NEXT_PUBLIC_)
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_MINI_APP_ID=
ZALO_OA_ID=
ZALO_ZNS_CONFIGURED=false
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
LPR_PROVIDER=mock
LPR_API_URL=
LPR_API_KEY=
LMS_PROVIDER=mock

FEATURE_GUEST_PASS=true
FEATURE_KILL_SWITCH=true
FEATURE_SOS=true
FEATURE_REWARDS=true
FEATURE_CARPOOL=true
FEATURE_SCHEDULE_PRIORITY=true
ZERO_LOST_NUDGE_MINUTES=3
EARLY_BIRD_CUTOFF=07:00
EARLY_BIRD_POINTS=10
SAMPLE_DAILY_FEE_VND=10000
