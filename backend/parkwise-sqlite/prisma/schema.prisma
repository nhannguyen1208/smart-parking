generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  zaloUserId   String   @unique
  phone        String?  @unique
  displayName  String
  studentId    String?
  dateOfBirth  String?
  /** Zalo OA user id (idByOA) — required for real OA inbox notifications */
  zaloOaId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles Vehicle[]
}

model Vehicle {
  id          String    @id
  plate       String    @unique
  rfidTag     String    @unique
  ownerName   String
  ownerId     String
  locked      Boolean   @default(false)
  zone        String?
  row         String?
  note        String?
  zoneSavedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  guestPasses     GuestPass[]
  events          Event[]
  safeRideSessions SafeRideSession[]

  @@index([ownerId])
}

model GuestPass {
  id             String    @id @default(cuid())
  code           String    @unique
  vehicleId      String
  hostPlate      String
  hostZaloUserId String
  guestName      String
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model SafeRideSession {
  id        String    @id @default(cuid())
  token     String    @unique
  vehicleId String
  status    String    @default("ACTIVE")
  expiresAt DateTime
  lastLat   Float?
  lastLng   Float?
  lastAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([expiresAt])
}

model Event {
  id        String   @id @default(cuid())
  type      String
  message   String?
  vehicleId String?
  payload   String?
  createdAt DateTime @default(now())

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([vehicleId])
}
