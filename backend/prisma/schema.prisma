generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Vehicle {
  id         String   @id
  plate      String   @unique
  rfidTag    String   @unique
  ownerName  String
  zaloUserId String
  locked     Boolean  @default(false)
  zone       String?
  row        String?
  note       String?
  zoneSavedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guestPasses GuestPass[]
  events      Event[]
}

model GuestPass {
  id             String    @id @default(cuid())
  code           String    @unique
  vehicleId      String
  hostPlate      String
  hostZaloUserId String
  guestName      String
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  usedAt         DateTime?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Event {
  id        String   @id @default(cuid())
  type      String
  message   String?
  vehicleId String?
  payload   String? // JSON string for extra fields
  createdAt DateTime @default(now())

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([vehicleId])
}
