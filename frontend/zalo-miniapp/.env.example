# Shared ParkWise API (Mongo Express — same as web)
VITE_API_URL=http://localhost:4000

# Zalo Mini App ID from https://mini.zalo.me (required for zmp login / deploy / device mode)
APP_ID=YOUR_ZALO_MINI_APP_ID
VITE_ZALO_MINI_APP_ID=YOUR_ZALO_MINI_APP_ID

# Optional: Google Maps JS API key (billing required). Night-Owl currently uses
# free Leaflet + OpenStreetMap tiles — no key needed.
# VITE_GOOGLE_MAPS_API_KEY=
