{
  "name": "smart-parking",
  "version": "0.1.0",
  "private": true,
  "description": "VNUK ParkWise monorepo — frontend/ (Next.js) + backend/ (Express API)",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "seed": "npm run seed --prefix backend",
    "test": "npm run test --prefix backend",
    "test:api": "npm run test:api --prefix backend",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:ui": "node scripts/db-ui.mjs",
    "parkwise:sqlite": "npm run dev --prefix backend/parkwise-sqlite",
    "parkwise:app": "npm run dev --prefix frontend/zalo-miniapp",
    "parkwise:zalo": "node scripts/parkwise-zalo.mjs",
    "parkwise:zalo:deploy": "npm run zmp:deploy --prefix frontend/zalo-miniapp",
    "parkwise:tunnel:setup": "node scripts/setup-named-tunnel.mjs",
    "parkwise:rfid": "npm run simulate:rfid --prefix backend/parkwise-sqlite",
    "parkwise:db": "npm run db:studio --prefix backend/parkwise-sqlite",
    "parkwise:seed": "npm run db:seed --prefix backend/parkwise-sqlite"
  },
  "devDependencies": {
    "mongodb": "^7.7.0"
  }
}
